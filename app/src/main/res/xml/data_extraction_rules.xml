<?xml version="1.0" encoding="utf-8"?>
<!-- La bóveda local es una caché: se reconstruye desde la API, no se respalda en la nube. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
